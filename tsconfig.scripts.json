{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The release check decides what reaches the registry, so it is typechecked like the package.
    // A root script outside every tsconfig is checked by nothing, and nothing says so.
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "migrate/vitest.config.ts"]
}
