{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `src/node/` and the tests. This is the only place a `node:` import typechecks, which is why
    // the two configs exist: a root-level @types/node is visible to every workspace, so without
    // the split a stray `node:crypto` in `src/` would typecheck fine and break a Worker.
    //
    // No DOM here: this program runs on Node, whose `Response` and `ReadableStream` come from
    // @types/node. With both declared, `Readable.toWeb()` returns Node's `ReadableStream` type and
    // `new Response()` wants DOM's, for what is one class at runtime. Dropping DOM changed no
    // emitted file outside `src/node/`, checked by building both ways.
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "./src",
    "noEmit": true
  },
  "include": ["src/**/*"]
}
