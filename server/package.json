{
  "name": "@gusnips/server",
  "version": "0.0.0",
  "description": "The layer under a TypeScript backend: one error shape, one response envelope, one retry rule, one logger.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salomé",
  "homepage": "https://github.com/gusnips/serverkit/tree/main/server#readme",
  "bugs": {
    "url": "https://github.com/gusnips/serverkit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backend",
    "hono",
    "errors",
    "logging",
    "retry",
    "typescript"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "purity": "bun run scripts/check-purity.ts",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run purity && bun run test && bun run build && bun run sync:docs",
    "release:patch": "bun pm version patch && bun publish --access public",
    "release:minor": "bun pm version minor && bun publish --access public",
    "release:major": "bun pm version major && bun publish --access public"
  },
  "peerDependencies": {
    "hono": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "hono": "^4.10.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/serverkit.git",
    "directory": "server"
  }
}
