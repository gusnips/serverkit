{
  "name": "@gusnips/server",
  "version": "0.8.25",
  "description": "The layer under a TypeScript backend: one error shape, one response envelope, one retry rule, one logger.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Salom\u00e9",
  "homepage": "https://github.com/gusnips/serverkit/tree/main/server#readme",
  "bugs": {
    "url": "https://github.com/gusnips/serverkit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "default": "./dist/supabase/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "default": "./dist/pg/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq/index.d.ts",
      "default": "./dist/bullmq/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./mail": {
      "types": "./dist/node/mail/index.d.ts",
      "default": "./dist/node/mail/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backend",
    "errors",
    "hono",
    "logging",
    "retry",
    "supabase",
    "typescript",
    "postgres",
    "redis",
    "ssrf",
    "bullmq",
    "nodemailer",
    "mcp",
    "openapi"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "purity": "bun run scripts/check-purity.ts",
    "sync:docs": "cp ../LICENSE .",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run purity && bun run test && bun run build && bun run sync:docs",
    "release:patch": "bun pm version patch && bun publish --access public",
    "release:minor": "bun pm version minor && bun publish --access public",
    "release:major": "bun pm version major && bun publish --access public"
  },
  "peerDependencies": {
    "@gusnips/http": ">=0.1.1 <1",
    "hono": ">=4.9.9 <5",
    "@supabase/supabase-js": ">=2.91 <3",
    "pg": ">=8.13 <9",
    "ioredis": ">=5.6 <7",
    "bullmq": ">=5.76 <7",
    "nodemailer": ">=6.10 <11",
    "@modelcontextprotocol/sdk": ">=1.29 <2"
  },
  "peerDependenciesMeta": {
    "@gusnips/http": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gusnips/http": ">=0.1.1 <1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@supabase/supabase-js": "^2.113.0",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.0",
    "@types/smtp-server": "^3.5.13",
    "bullmq": "^5.81.5",
    "hono": "^4.10.6",
    "ioredis": "^5.10.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.0",
    "smtp-server": "^3.19.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/serverkit.git",
    "directory": "server"
  }
}
