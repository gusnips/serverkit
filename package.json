{
  "name": "serverkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "migrate"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint migrate scripts",
    "release:check": "bun run scripts/check-release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run build && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.12.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.2"
  }
}
